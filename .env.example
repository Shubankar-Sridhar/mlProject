# Database
DB_PASSWORD=secure_password
DATABASE_URL=postgresql://admin:${DB_PASSWORD}@postgres:5432/metadata
METADATA_DB_URL=postgresql://admin:${DB_PASSWORD}@postgres:5432/metadata

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# Model
MODEL_PATH=/app/models
DEFAULT_MODEL_ID=qwen_enterprise_v1
LLAMA_CPP_PATH=/usr/local/bin/llama-cpp

# API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000","http://frontend:80"]
REACT_APP_API_URL=http://localhost:8000/api/v1

# Training
TRAINING_BATCH_SIZE=4
TRAINING_EPOCHS=3
TRAINING_LEARNING_RATE=2e-4
LORA_R=64
LORA_ALPHA=16
LORA_DROPOUT=0.05

# Security
READ_ONLY_DB=true
MAX_ROWS=10000
SQL_TIMEOUT_SECONDS=30

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin

# Sentry (optional)
SENTRY_DSN=